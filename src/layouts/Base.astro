---
import { execSync } from 'node:child_process';
import '../styles/global.css';
import { profile } from '../data';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = profile.name,
  description = 'Faris Sharara is a backend engineer in Egypt working in C#, TypeScript, and Java.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Build stamp: the commit this build came from, read at build time.
let commit = '';
try {
  commit = execSync('git rev-parse --short HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
} catch {}
const builtOn = new Date().toISOString().slice(0, 10);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: Astro.site?.toString(),
  address: { '@type': 'PostalAddress', addressCountry: 'EG' },
  alumniOf: 'Zewail City of Science, Technology & Innovation',
  sameAs: Object.values(profile.links),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script is:inline>
      const t = localStorage.getItem('theme');
      if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen">
    <div class="mx-auto max-w-[38rem] px-6 pt-16 pb-20 sm:pt-24">
      <slot />

      <footer class="meta mt-24 flex items-center justify-between border-t border-line pt-6">
        <span>
          {commit ? (
            <a class="u" href={`https://github.com/sharara6/sharara6.github.io/commit/${commit}`}>build {commit}</a>
          ) : (
            'build'
          )}
          {' · '}{builtOn}
        </span>
        <button id="theme-toggle" class="u cursor-pointer" aria-label="Toggle colour theme">
          <span class="dark:hidden">dark mode</span><span class="hidden dark:inline">light mode</span>
        </button>
      </footer>
    </div>

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      });

      // Animate charts when they scroll into view
      const charts = document.querySelectorAll('[data-chart]');
      if (charts.length) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }),
          { threshold: 0.4 },
        );
        charts.forEach((c) => io.observe(c));
      }
    </script>
  </body>
</html>
